<view class="page">
  <view class="nav-bar">
    <view class="nav-bar-left" bindtap="onBack">
      <text class="back-arrow">‹</text>
    </view>
    <view class="nav-bar-title">个人信息</view>
    <view class="nav-bar-right"></view>
  </view>

  <view class="profile-container">
    <view class="profile-header">
      <view class="avatar-section">
        <view class="avatar-wrapper">
          <image class="avatar-image" src="{{userAvatar}}" mode="aspectFill" />
          <!-- 微信头像选择按钮（覆盖在头像上） -->
          <button class="avatar-overlay-btn" open-type="chooseAvatar" bindchooseavatar="onWechatAvatarChoose"></button>
        </view>
        <view class="level-badge">
          <text class="level-text">{{memberLevelName}}</text>
        </view>
      </view>
    </view>

    <view class="info-section">
      <view class="info-card">
        <view class="info-item" bindtap="onNicknameClick">
          <view class="info-left">
            <text class="info-label">用户名</text>
          </view>
          <view class="info-right">
            <text class="info-value">{{username}}</text>
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="info-divider"></view>

        <view class="info-item">
          <view class="info-left">
            <text class="info-label">手机号</text>
          </view>
          <view class="info-right">
            <text class="info-value">{{phone}}</text>
          </view>
        </view>

        <view class="info-divider"></view>

        <!-- <view class="info-item">
          <view class="info-left">
            <text class="info-label">会员等级</text>
          </view>
          <view class="info-right">
            <text class="info-value highlight">{{memberLevelName}}</text>
          </view>
        </view> -->

        <view class="info-divider"></view>

        <view class="info-item">
          <view class="info-left">
            <text class="info-label">积分</text>
          </view>
          <view class="info-right">
            <text class="info-value points">{{points}}</text>
          </view>
        </view>

        <view class="info-divider"></view>

        <!-- <view class="info-item">
          <view class="info-left">
            <text class="info-label">成长值</text>
          </view>
          <view class="info-right">
            <text class="info-value growth">{{growthValue}}</text>
          </view>
        </view> -->
      </view>
    </view>

    <!-- <view class="tips-section">
      <text class="tips-text" wx:if="{{nextLevelGrowth > 0}}">成长值达到 {{nextLevelGrowth}} 可升级为 {{nextLevelName}}</text>
      <text class="tips-text" wx:if="{{nextLevelGrowth === 0}}">已是最高等级会员</text>
    </view> -->
  </view>

  <view class="modal-mask {{showNicknameModal ? 'modal-show' : ''}}" bindtap="onCancelNickname"></view>
  <view class="nickname-modal {{showNicknameModal ? 'modal-show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">修改昵称</text>
    </view>
    <view class="modal-body">
      <input 
        class="modal-input"
        type="text"
        placeholder="请输入昵称"
        placeholder-class="modal-placeholder"
        value="{{tempNickname}}"
        maxlength="20"
        bindinput="onNicknameInput"
        focus="{{showNicknameModal}}"
      />
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="onCancelNickname">取消</button>
      <button class="modal-btn confirm" bindtap="onConfirmNickname">确定</button>
    </view>
  </view>
</view>
